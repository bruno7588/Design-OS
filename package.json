{
  "name": "design-os",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "concurrently -n shell,server,playground -c cyan,magenta,green \"pnpm --filter @design-os/shell dev\" \"pnpm --filter @design-os/server dev\" \"pnpm --filter @design-os/playground dev\"",
    "build": "pnpm -r build",
    "test": "vitest run",
    "inventory": "node scripts/inventory.mts",
    "mock-data": "node packages/mock-data/bin/cli.mts",
    "session-messages": "node scripts/session-messages.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
