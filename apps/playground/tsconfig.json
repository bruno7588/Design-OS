{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@replicas/*": ["./src/replicas/*"],
      "@playground/*": ["./src/*"]
    }
  },
  "include": ["src", "demos"]
}
